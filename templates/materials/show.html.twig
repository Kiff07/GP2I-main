{% extends 'base.html.twig' %}

{% block title %}{{ material.name }} - GP2I{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <p class="eyebrow">Fiche materiel</p>
            <h1>{{ material.name }}</h1>
        </div>
        <div class="button-row">
            <a class="button secondary" href="{{ path('app_materials_edit', {'id': material.id}) }}">Modifier</a>
            {{ include('materials/_delete_form.html.twig') }}
        </div>
    </section>

    <section class="detail-grid">
        <div class="detail-item"><span>Reference</span><strong>{{ material.reference }}</strong></div>
        <div class="detail-item"><span>Numero de serie</span><strong>{{ material.serialNumber }}</strong></div>
        <div class="detail-item"><span>Quantite</span><strong>{{ material.quantity }}</strong></div>
        <div class="detail-item"><span>Statut</span><strong>{{ material.statusLabel }}</strong></div>
        <div class="detail-item"><span>Emplacement</span><strong>{{ material.location ?: '-' }}</strong></div>
        <div class="detail-item"><span>Categorie</span><strong>{{ material.category ? material.category.name : '-' }}</strong></div>
        <div class="detail-item"><span>Date d achat</span><strong>{{ material.purchaseDate ? material.purchaseDate|date('d/m/Y') : '-' }}</strong></div>
        <div class="detail-item"><span>Prix d achat</span><strong>{{ material.purchasePrice ? material.purchasePrice|number_format(2, ',', ' ') ~ ' EUR' : '-' }}</strong></div>
        <div class="detail-item"><span>Cree le</span><strong>{{ material.createdAt ? material.createdAt|date('d/m/Y H:i') : '-' }}</strong></div>
    </section>
{% endblock %}
