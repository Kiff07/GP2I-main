{% extends 'base.html.twig' %}

{% block title %}Materiels - GP2I{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <p class="eyebrow">Inventaire</p>
            <h1>Materiels</h1>
        </div>
        {% if is_granted('ROLE_MANAGER') %}
            <a class="button primary" href="{{ path('app_materials_new') }}">Nouveau materiel</a>
        {% endif %}
    </section>

    <section class="content-panel">
        {# Recherche instantanee grace au controleur Stimulus "search" #}
        <form class="filter-bar" method="get" action="{{ path('app_materials_index') }}"
              data-controller="search" data-search-delay-value="400">
            <div class="filter-field search-field">
                <label for="q">Rechercher</label>
                <input type="search" id="q" name="q" value="{{ filters.q|default('') }}"
                       placeholder="Nom, reference, serie, localisation, categorie..."
                       autocomplete="off" data-action="input->search#queueSubmit">
            </div>

            <div class="filter-field">
                <label for="status">Statut</label>
                <select id="status" name="status" data-action="change->search#queueSubmit">
                    <option value="">Tous les statuts</option>
                    {% for label, value in statusChoices %}
                        <option value="{{ value }}" {% if filters.status is defined and filters.status == value %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-field">
                <label for="category">Categorie</label>
                <select id="category" name="category" data-action="change->search#queueSubmit">
                    <option value="">Toutes</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if filters.category is defined and filters.category == category.id %}selected{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-field">
                <label for="supplier">Fournisseur</label>
                <select id="supplier" name="supplier" data-action="change->search#queueSubmit">
                    <option value="">Tous</option>
                    {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}" {% if filters.supplier is defined and filters.supplier == supplier.id %}selected{% endif %}>{{ supplier.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="button primary">Rechercher</button>
                <a class="button secondary" href="{{ path('app_materials_index') }}">Reinitialiser</a>
            </div>
        </form>

        <p class="result-count" aria-live="polite">
            {{ total }} materiel{{ total > 1 ? 's' : '' }} trouve{{ total > 1 ? 's' : '' }}
            {% if filters.q %}pour &laquo; {{ filters.q }} &raquo;{% endif %}
        </p>

        {% if materials is not empty %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Reference</th>
                            <th>Serie</th>
                            <th>Quantite</th>
                            <th>Statut</th>
                            <th>Categorie</th>
                            <th>Fournisseur</th>
                            <th>Emplacement</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for material in materials %}
                            <tr>
                                <td><strong>{{ material.name }}</strong></td>
                                <td>{{ material.reference }}</td>
                                <td>{{ material.serialNumber ?: '-' }}</td>
                                <td>
                                    <span class="{{ material.quantity <= 2 ? 'stock-low' : '' }}"
                                          {% if material.quantity <= 2 %}title="Stock faible"{% endif %}>
                                        {{ material.quantity }}{% if material.quantity == 0 %} (rupture){% elseif material.quantity <= 2 %} (faible){% endif %}
                                    </span>
                                </td>
                                <td><span class="status status--{{ material.status }}">{{ material.statusLabel }}</span></td>
                                <td>{{ material.category ? material.category.name : '-' }}</td>
                                <td>{{ material.supplier ? material.supplier.name : '-' }}</td>
                                <td>{{ material.location ?: '-' }}</td>
                                <td class="actions">
                                    <a href="{{ path('app_materials_show', {'id': material.id}) }}">Voir</a>
                                    {% if is_granted('ROLE_MANAGER') %}
                                        <a href="{{ path('app_materials_edit', {'id': material.id}) }}">Modifier</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pages > 1 %}
                <nav class="pagination" aria-label="Pagination">
                    {% if page > 1 %}
                        <a class="button secondary small" href="{{ path('app_materials_index', app.request.query.all|merge({page: page - 1})) }}">&laquo; Precedent</a>
                    {% endif %}
                    <span class="pagination-info">Page {{ page }} / {{ pages }}</span>
                    {% if page < pages %}
                        <a class="button secondary small" href="{{ path('app_materials_index', app.request.query.all|merge({page: page + 1})) }}">Suivant &raquo;</a>
                    {% endif %}
                </nav>
            {% endif %}
        {% else %}
            <div class="empty-state">
                <p class="empty">Aucun materiel trouve avec ces criteres.</p>
                <a class="button secondary" href="{{ path('app_materials_index') }}">Reinitialiser les filtres</a>
            </div>
        {% endif %}
    </section>
{% endblock %}
