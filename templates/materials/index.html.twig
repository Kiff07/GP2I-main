{% extends 'base.html.twig' %}

{% block title %}Materiels - GP2I{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <p class="eyebrow">Inventaire</p>
            <h1>Materiels</h1>
        </div>
        <a class="button primary" href="{{ path('app_materials_new') }}">Nouveau materiel</a>
    </section>

    <section class="content-panel">
        <form class="filter-bar" method="get" action="{{ path('app_materials_index') }}">
            <div class="filter-field search-field">
                <label for="q">Rechercher</label>
                <input type="text" id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Nom, reference, serie, localisation...">
            </div>

            <div class="filter-field">
                <label for="status">Statut</label>
                <select id="status" name="status">
                    <option value="">Tous les statuts</option>
                    {% for label, value in statusChoices %}
                        <option value="{{ value }}" {% if filters.status is defined and filters.status == value %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-field">
                <label for="category">Categorie</label>
                <select id="category" name="category">
                    <option value="">Toutes</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if filters.category is defined and filters.category == category.id %}selected{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-field">
                <label for="supplier">Fournisseur</label>
                <select id="supplier" name="supplier">
                    <option value="">Tous</option>
                    {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}" {% if filters.supplier is defined and filters.supplier == supplier.id %}selected{% endif %}>{{ supplier.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="button primary">Rechercher</button>
                <a class="button secondary" href="{{ path('app_materials_index') }}">Reinitialiser</a>
            </div>
        </form>

        {% if materials is not empty %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Reference</th>
                            <th>Serie</th>
                            <th>Quantite</th>
                            <th>Statut</th>
                            <th>Categorie</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for material in materials %}
                            <tr>
                                <td>{{ material.name }}</td>
                                <td>{{ material.reference }}</td>
                                <td>{{ material.serialNumber }}</td>
                                <td>{{ material.quantity }}</td>
                                <td><span class="status">{{ material.statusLabel }}</span></td>
                                <td>{{ material.category ? material.category.name : '-' }}</td>
                                <td class="actions">
                                    <a href="{{ path('app_materials_show', {'id': material.id}) }}">Voir</a>
                                    <a href="{{ path('app_materials_edit', {'id': material.id}) }}">Modifier</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="empty">Aucun materiel trouve.</p>
        {% endif %}
    </section>
{% endblock %}
