{% extends 'base.html.twig' %}

{% block title %}{{ title }} - GP2I{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <p class="eyebrow">Détail</p>
            <h1>{{ title }}</h1>
        </div>
        <div class="button-row">
            <a class="button secondary" href="{{ path(edit_path, {'id': entity.id}) }}">Modifier</a>
            <a class="button secondary" href="{{ path(back_path) }}">Retour</a>
            {% if return_path is defined and return_path and is_granted('ROLE_MANAGER') %}
                <form method="post" action="{{ path(return_path, {'id': entity.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('return' ~ entity.id) }}">
                    <button class="button primary">Marquer comme retourné</button>
                </form>
            {% endif %}
            {% if delete_path is defined and delete_path and is_granted('ROLE_MANAGER') %}
                <form method="post" action="{{ path(delete_path, {'id': entity.id}) }}" onsubmit="return confirm('Supprimer cet enregistrement ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                    <button class="button danger">Supprimer</button>
                </form>
            {% endif %}
        </div>
    </section>

    <section class="detail-grid">
        {% for label, value in fields %}
            <div class="detail-item {{ value matches '/\\n/' ? 'wide' : '' }}">
                <span>{{ label }}</span>
                <strong>{{ value }}</strong>
            </div>
        {% endfor %}
    </section>
{% endblock %}
