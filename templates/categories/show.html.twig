{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - GP2I{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <p class="eyebrow">Catégorie</p>
            <h1>{{ category.name }}</h1>
        </div>
        <div class="button-row">
            <a class="button secondary" href="{{ path('app_categories_edit', {'id': category.id}) }}">Modifier</a>
            {{ include('categories/_delete_form.html.twig') }}
        </div>
    </section>

    <section class="content-panel">
        <p class="description">{{ category.description }}</p>
    </section>

    <section class="content-panel">
        <div class="section-title">
            <h2>Matériels associes</h2>
        </div>
        {% if category.materials is not empty %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Référence</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for material in category.materials %}
                            <tr>
                                <td>{{ material.name }}</td>
                                <td>{{ material.reference }}</td>
                                <td><span class="status status--{{ material.status }}">{{ material.statusLabel }}</span></td>
                                <td class="actions"><a href="{{ path('app_materials_show', {'id': material.id}) }}">Voir</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="empty">Aucun matériel associé.</p>
        {% endif %}
    </section>
{% endblock %}
