{% extends 'base.html.twig' %}

{% block title %}Catégories - GP2I{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <p class="eyebrow">Classement</p>
            <h1>Catégories</h1>
        </div>
        <a class="button primary" href="{{ path('app_categories_new') }}">Nouvelle catégorie</a>
    </section>

    <section class="content-panel">
        <form class="filter-bar" method="get" action="{{ path('app_categories_index') }}" data-controller="search" data-search-delay-value="400">
            <div class="filter-field search-field">
                <label for="q">Rechercher</label>
                <input type="search" id="q" name="q" value="{{ q|default('') }}" placeholder="Nom ou description..." autocomplete="off" data-action="input->search#queueSubmit">
            </div>
            <div class="filter-actions">
                <button type="submit" class="button primary">Rechercher</button>
                <a class="button secondary" href="{{ path('app_categories_index') }}">Réinitialiser</a>
            </div>
        </form>

        {% if categories is not empty %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Matériels</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr>
                                <td>{{ category.name }}</td>
                                <td>{{ category.description|length > 90 ? category.description|slice(0, 90) ~ '...' : category.description }}</td>
                                <td>{{ category.materials|length }}</td>
                                <td class="actions">
                                    <a href="{{ path('app_categories_show', {'id': category.id}) }}">Voir</a>
                                    <a href="{{ path('app_categories_edit', {'id': category.id}) }}">Modifier</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="empty">Aucune catégorie trouvée.</p>
        {% endif %}
    </section>
{% endblock %}
