{{ form_start(form, {'attr': {'class': 'form-card'}}) }}
    <div class="form-grid">
        {{ form_row(form.name) }}
        {{ form_row(form.contactName) }}
        {{ form_row(form.email) }}
        {{ form_row(form.phone) }}
        <div class="full">{{ form_row(form.address) }}</div>
    </div>
    <div class="form-actions">
        <button class="button primary">{{ button_label|default('Enregistrer') }}</button>
        <a class="button secondary" href="{{ path('app_suppliers_index') }}">Annuler</a>
    </div>
{{ form_end(form) }}
